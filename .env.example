# ============================================================
# 곁눈(Gyeotnun) 환경변수 예시 파일
# 사용법: cp .env.example .env  후 각자 발급받은 키를 채운다.
# ★ 이 파일에는 절대로 실제 키 값을 적지 않는다. (값은 항상 비워둘 것)
# ★ .env 는 .gitignore 최상단에 등록되어 있다.
# ============================================================

# Claude API (김태희 - 질문 생성 프롬프트 체인 / 박진 - 이미지 인식(Vision))
# ★ 이미지 OCR 도 이 키로 동작한다. 별도 Vision 키가 필요 없다.
ANTHROPIC_API_KEY=

# 네이버 검색 API (김유리 - 실시간 검색 대조)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [선택 - 롤백용. 평소에는 비워 둘 것] Upstage Solar Embedding.
# ★ 지금은 쓰지 않는다. 공식 문서 임베딩 검색은 2026-08-04 부터 자체 서버의
#   로컬 모델(dragonkue/multilingual-e5-small-ko-v2)로 돌아간다 -
#   질의 텍스트가 외부로 나가지 않는다. 이 키가 비어 있어도 정상 동작한다.
# 필요해지는 경우는 하나뿐이다: services/embeddings.py 의 EMBEDDING_PROVIDER 를
#   "upstage" 로 되돌리는 롤백. 그때만 console.upstage.ai 에서 발급해 채운다
#   ($0.10/1M 토큰, 코퍼스 1회 임베딩에 대략 $0.17~0.28).
UPSTAGE_API_KEY=

# (사용 안 함) 과거 Google Cloud Vision 용. 이미지 인식이 Claude Vision 으로
# 옮겨 가면서 더 이상 쓰지 않는다. 얼굴 블러(TODO)에서 필요해지면 그때 되살릴 것.
GOOGLE_VISION_API_KEY=

# DB (박진영) - 로컬 docker-compose 기본값 예시
# postgresql+psycopg2://gyeotnun:gyeotnun@db:5432/gyeotnun
DATABASE_URL=

# 실행 환경: local | dev | prod
APP_ENV=

# 업로드 최대 용량(MB)
MAX_UPLOAD_MB=
