# ============================================================
# 곁눈(Gyeotnun) 환경변수 예시 파일
# 사용법: cp .env.example .env  후 각자 발급받은 키를 채운다.
# ★ 이 파일에는 절대로 실제 키 값을 적지 않는다. (값은 항상 비워둘 것)
# ★ .env 는 .gitignore 최상단에 등록되어 있다.
# ============================================================

# Claude API (김태희 - 질문 생성 프롬프트 체인 / 박진 - 이미지 인식(Vision))
# ★ 이미지 OCR 도 이 키로 동작한다. 별도 Vision 키가 필요 없다.
ANTHROPIC_API_KEY=

# 네이버 검색 API (김유리 - 실시간 검색 대조)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (사용 안 함) 과거 Google Cloud Vision 용. 이미지 인식이 Claude Vision 으로
# 옮겨 가면서 더 이상 쓰지 않는다. 얼굴 블러(TODO)에서 필요해지면 그때 되살릴 것.
GOOGLE_VISION_API_KEY=

# DB (박진영) - 로컬 docker-compose 기본값 예시
# postgresql+psycopg2://gyeotnun:gyeotnun@db:5432/gyeotnun
DATABASE_URL=

# 실행 환경: local | dev | prod
APP_ENV=

# 업로드 최대 용량(MB)
MAX_UPLOAD_MB=
