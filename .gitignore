# ============================================================
# 곁눈(Gyeotnun) - .gitignore
# ★ 최우선: 실제 API 키가 담긴 .env 는 절대 커밋 금지
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# DB / 로컬 데이터
*.db
*.sqlite
*.sqlite3
pgdata/

# 업로드 원본 이미지 (개인정보 - 처리 후 즉시 파기 원칙)
api/uploads/
uploads/
tmp/

# Node / Vite
node_modules/
dist/
.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 코퍼스 원본(용량) - .gitkeep 만 유지
corpus/public_data/*
!corpus/public_data/.gitkeep

# 임베딩 인덱스(용량 + API 비용을 들여 만든 산출물, api/tools/build_embedding_index.py
# 로 재생성 가능) - corpus/ 가 읽기 전용 마운트라 api/data/ 밑에 저장한다.
api/data/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 가드레일 벤치 실행 결과 (스크립트로 재생성 가능)
api/tools/guardrail_bench_result.json

# 배포: nginx 활성 설정(http.conf/https.conf 를 복사해 만드는 서버 로컬 산출물)과
# Let's Encrypt 인증서·개인키. 절대 커밋하지 않는다.
deploy/nginx/active.conf
deploy/certbot/conf/*
!deploy/certbot/conf/.gitkeep
deploy/certbot/www/*
!deploy/certbot/www/.gitkeep

# nginx reload crontab 로그 (서버 로컬 산출물)
deploy/nginx-reload.log

# Figma Make 내보내기 원본 (참고용, 프로젝트 본체가 아니다) - 여기서 필요한 값만
# 손으로 옮겨 web/src 에 반영한다(web/src/styles.css "Figma 이식" 절 참고).
# src/imports/ 의 자동생성 코드(393x852 고정 좌표)는 절대 가져오지 않는다.
web/곁눈(figma)/

# 보안 미해결 항목(라이브 공격 표면) - 공개 저장소 금지
docs/security/internal/
