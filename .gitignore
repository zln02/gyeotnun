# ============================================================
# 곁눈(Gyeotnun) - .gitignore
# ★ 최우선: 실제 API 키가 담긴 .env 는 절대 커밋 금지
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# DB / 로컬 데이터
*.db
*.sqlite
*.sqlite3
pgdata/

# 업로드 원본 이미지 (개인정보 - 처리 후 즉시 파기 원칙)
api/uploads/
uploads/
tmp/

# Node / Vite
node_modules/
dist/
.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 코퍼스 원본(용량) - .gitkeep 만 유지
corpus/public_data/*
!corpus/public_data/.gitkeep

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 가드레일 벤치 실행 결과 (스크립트로 재생성 가능)
api/tools/guardrail_bench_result.json

# 배포: nginx 활성 설정(http.conf/https.conf 를 복사해 만드는 서버 로컬 산출물)과
# Let's Encrypt 인증서·개인키. 절대 커밋하지 않는다.
deploy/nginx/active.conf
deploy/certbot/conf/*
!deploy/certbot/conf/.gitkeep
deploy/certbot/www/*
!deploy/certbot/www/.gitkeep
