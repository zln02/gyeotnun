# ============================================================
# 곁눈(Gyeotnun) 프론트 환경변수 예시
# 사용법: cp .env.example .env.local  (Vite 는 .env.local 을 git에 안 올린다)
# ============================================================

# 1 이면 모든 API 호출이 mock(고정 응답)으로 간다. 비워 두면 실제 백엔드를 쓴다.
# 주소창 ?mock=1 / ?mock=0 이 이 값보다 항상 우선한다(임시로 바꿔 볼 때 사용).
VITE_USE_MOCK=
